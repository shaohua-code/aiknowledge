# =============================================================================
# 智能知识中台后端环境变量示例
# 复制本文件为 .env 并填入真实值；真实密钥严禁提交到 Git
# =============================================================================

# 运行环境：development / staging / production
APP_ENV=development

# -----------------------------------------------------------------------------
# 数据库与缓存
# -----------------------------------------------------------------------------

# PostgreSQL 异步连接字符串（必须使用 asyncpg 驱动）
# 格式：postgresql+asyncpg://用户:密码@主机:端口/数据库名
# 本地开发默认对应 docker-compose.yml 中 postgres 服务（主机端口映射为 5433）
DATABASE_URL=postgresql+asyncpg://aiknowledge:sss980318..@localhost:5433/knowledge_hub

# Redis 连接字符串，用于项目级限流与幂等存储
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Celery 任务队列
# -----------------------------------------------------------------------------

# Celery 消息队列地址（通常复用 Redis，建议使用独立 DB 编号）
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery 结果后端地址
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# 对象存储
# -----------------------------------------------------------------------------

# 对象存储类型：local（本地目录）或 s3（S3 兼容存储）
OBJECT_STORAGE_PROVIDER=local

# 本地存储根目录，或 S3 bucket 与前缀
OBJECT_STORAGE_PATH=./storage

# -----------------------------------------------------------------------------
# 聊天模型配置（OpenAI 兼容接口）
# -----------------------------------------------------------------------------

# 聊天模型 Provider：openai
CHAT_PROVIDER=openai

# 聊天模型名称
CHAT_MODEL=gpt-4o-mini

# 聊天模型 API Key（真实密钥留空，由部署环境注入）
CHAT_API_KEY=

# 聊天模型基础 URL
CHAT_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Embedding 模型配置
# -----------------------------------------------------------------------------

# Embedding Provider：openai
EMBEDDING_PROVIDER=openai

# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-3-small

# Embedding API Key（真实密钥留空）
EMBEDDING_API_KEY=

# Embedding 基础 URL
EMBEDDING_BASE_URL=https://api.openai.com/v1

# 向量维度，需与数据库 pgvector 列维度一致，默认 1536
EMBEDDING_DIMENSION=1536

# -----------------------------------------------------------------------------
# Web 搜索配置
# -----------------------------------------------------------------------------

# Web 搜索 Provider（如 tavily、serper，留空表示禁用联网）
WEB_SEARCH_PROVIDER=

# Web 搜索 API Key（真实密钥留空）
WEB_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# 管理密钥
# -----------------------------------------------------------------------------

# 管理密钥：保护项目管理接口（POST/GET/PATCH /api/v1/projects）
# 仅运维与平台管理员持有，业务项目不使用此密钥
MANAGEMENT_API_KEY=kh_admin_a3f8e2b1c9d4f7e6_20260731
# -----------------------------------------------------------------------------
# 链路限制参数
# -----------------------------------------------------------------------------

# 项目级限流：每 API Key 每分钟最大请求数，默认 60
RATE_LIMIT_PER_MINUTE=60

# 研究整体硬超时（秒），默认 15
RESEARCH_HARD_TIMEOUT_SECONDS=15

# 联网搜索超时（秒），默认 5
WEB_SEARCH_TIMEOUT_SECONDS=5

# 业务工具调用超时（秒），默认 4
TOOL_TIMEOUT_SECONDS=4

# 单次研究最大证据数，默认 8
MAX_EVIDENCE=8

# -----------------------------------------------------------------------------
# 跨域与日志配置
# -----------------------------------------------------------------------------

# CORS 允许的源列表（逗号分隔）
# 开发环境允许所有源（*），生产环境应明确列出前端域名
# 示例：https://ai.example.com,https://admin.example.com
CORS_ORIGINS=*

# 日志级别：DEBUG / INFO / WARNING / ERROR
# 生产环境建议 INFO（记录正常访问与业务日志）
# 排查问题时可临时设为 DEBUG 查看详细日志
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 可选：Sentry 错误监控（生产环境推荐）
# -----------------------------------------------------------------------------

# Sentry DSN：留空表示禁用，配置后未捕获异常自动上报到 Sentry
# 获取方式：Sentry 控制台 → 项目设置 → Client Keys
SENTRY_DSN=

# Sentry 采样率：0.0 ~ 1.0，生产环境建议 0.1（10% 采样以控制配额）
SENTRY_TRACES_SAMPLE_RATE=0.1
