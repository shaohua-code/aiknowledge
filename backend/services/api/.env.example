# 后端脱离 Docker 直接运行时使用的环境变量示例。
# 使用方法：复制为本目录 .env；数据库和 Redis 地址均指向宿主机。

# 运行环境：development、testing 或 production。
APP_ENV=development
# 平台显示名称。
APP_NAME=AI 知识能力底座

# 本机 PostgreSQL 地址；Docker 暴露端口为 5433。
DATABASE_URL=postgresql+asyncpg://aiknowledge@localhost:5433/aiknowledge_v2
# 本机 Redis 0 号库，保存限流和短期状态。
REDIS_URL=redis://localhost:6379/0
# 本机 Redis 1 号库，作为 Celery 消息队列。
CELERY_BROKER_URL=redis://localhost:6379/1
# 本机 Redis 2 号库，保存 Celery 执行结果。
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# 本地文件、网页原文和模型配置保存位置。
OBJECT_STORAGE_PATH=./storage

# 管理控制台登录邮箱。
ADMIN_EMAIL=admin@example.local
# 管理控制台登录密码；请替换示例值。
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Cookie 签名密钥；至少 32 位随机字符串。
SESSION_SECRET=replace-with-at-least-32-random-characters
# 管理员 Cookie 名称，一般无需修改。
SESSION_COOKIE_NAME=aik_admin_session
# 本地 HTTP 使用 false，生产 HTTPS 必须使用 true。
SESSION_COOKIE_SECURE=false
# 登录有效期，单位为秒。
SESSION_MAX_AGE_SECONDS=28800
# 允许访问后端的前端地址，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173

# 对话模型 Provider：disabled、openai 或 openai_compatible。
CHAT_PROVIDER=disabled
# 对话模型名称，例如 gpt-4.1-mini。
CHAT_MODEL=
# 对话模型密钥；也可在控制台设置页保存。
CHAT_API_KEY=
# 对话模型 API 根地址。
CHAT_BASE_URL=https://api.openai.com/v1

# 向量 Provider：local_hash、openai 或 openai_compatible。
EMBEDDING_PROVIDER=local_hash
# 向量模型名称；local-hash-v1 仅供开发联调。
EMBEDDING_MODEL=local-hash-v1
# 向量模型密钥；也可在控制台设置页保存。
EMBEDDING_API_KEY=
# 向量模型 API 根地址。
EMBEDDING_BASE_URL=https://api.openai.com/v1
# 当前数据库固定使用 1536 维向量，请勿直接修改。
EMBEDDING_DIMENSION=1536

# 联网搜索 Provider：disabled 或 serper。
WEB_SEARCH_PROVIDER=disabled
# Serper API Key；禁用时留空。
WEB_SEARCH_API_KEY=
# Serper API 根地址。
WEB_SEARCH_BASE_URL=https://google.serper.dev

# 单个应用密钥每分钟请求上限。
RATE_LIMIT_PER_MINUTE=60
# 模型回答超时秒数。
ANSWER_TIMEOUT_SECONDS=15
# 单次回答最多证据数量。
MAX_EVIDENCE=8
# 请求正文保留天数；0 表示不保留。
REQUEST_BODY_RETENTION_DAYS=0

# 远程网页/API 抓取超时秒数。
REMOTE_FETCH_TIMEOUT_SECONDS=20
# 远程响应最大字节数，默认 20 MB。
REMOTE_FETCH_MAX_BYTES=20971520
# 最多允许的安全重定向次数。
REMOTE_FETCH_MAX_REDIRECTS=5
# 网络错误自动重试次数。
REMOTE_FETCH_RETRIES=2
# 公开网页抓取 User-Agent。
REMOTE_FETCH_USER_AGENT=AIKnowledgeBot/2.1 (+public-knowledge-ingestion)
