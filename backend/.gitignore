# =============================================================================
# 智能知识中台后端 .gitignore
# =============================================================================

# 环境变量与密钥（真实配置严禁提交）
.env
.env.local
.env.*.local

# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# 类型检查缓存
.mypy_cache/
.ruff_cache/
.pytype/

# 构建产物
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# IDE 与编辑器
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 对象存储本地目录
storage/
uploads/

# 日志
*.log
logs/

# Alembic 迁移脚本缓存（保留 versions 目录，忽略临时文件）
alembic/__pycache__/
