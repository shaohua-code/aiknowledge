# AI 知识能力底座 Docker 环境变量示例。
# 使用方法：复制为根目录 .env，再修改密码和密钥；真实 .env 禁止提交 Git。

# PostgreSQL 登录用户名。
POSTGRES_USER=aiknowledge
# PostgreSQL 登录密码；请替换为本机强密码。
POSTGRES_PASSWORD=replace-with-a-local-password
# PostgreSQL 数据库名称。
POSTGRES_DB=aiknowledge_v2
# API 和 Worker 使用的数据库连接串；密码必须与 POSTGRES_PASSWORD 相同。
DATABASE_URL=postgresql+asyncpg://aiknowledge:replace-with-a-local-password@postgres:5432/aiknowledge_v2

# Redis 0 号库，保存限流和短期运行状态。
REDIS_URL=redis://redis:6379/0
# Redis 1 号库，作为 Celery 任务消息队列。
CELERY_BROKER_URL=redis://redis:6379/1
# Redis 2 号库，保存 Celery 任务执行结果。
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 运行环境：development、testing 或 production。
APP_ENV=development
# 平台显示名称。
APP_NAME=AI 知识能力底座
# 管理控制台登录邮箱。
ADMIN_EMAIL=admin@example.local
# 管理控制台登录密码；生产环境至少 12 位且不能使用示例值。
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# 管理员登录 Cookie 签名密钥；生产环境必须使用至少 32 位随机字符串。
SESSION_SECRET=replace-with-at-least-32-random-characters
# 管理员登录 Cookie 名称，一般无需修改。
SESSION_COOKIE_NAME=aik_admin_session
# 是否只允许 HTTPS 传输 Cookie；本地 HTTP 使用 false，生产环境必须为 true。
SESSION_COOKIE_SECURE=false
# 管理员登录有效期，单位为秒；28800 表示 8 小时。
SESSION_MAX_AGE_SECONDS=28800
# 允许访问 API 的前端地址；多个地址使用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173

# 文件、网页原文和模型配置的共享存储目录；Docker 内保持此值即可。
OBJECT_STORAGE_PATH=/data/storage

# 对话模型 Provider：disabled、openai 或 openai_compatible。
CHAT_PROVIDER=disabled
# 对话模型名称，例如 gpt-4.1-mini；未启用时可留空。
CHAT_MODEL=
# 对话模型 API Key；也可以登录管理控制台后在“设置”页面配置。
CHAT_API_KEY=
# 对话模型 API 根地址；兼容服务填写其 OpenAI 兼容地址。
CHAT_BASE_URL=https://api.openai.com/v1

# 向量模型 Provider：local_hash、openai 或 openai_compatible；local_hash 仅供本地测试。
EMBEDDING_PROVIDER=local_hash
# 向量模型名称；生产环境建议使用支持 1536 维输出的模型。
EMBEDDING_MODEL=local-hash-v1
# 向量模型 API Key；也可以在管理控制台“设置”页面配置。
EMBEDDING_API_KEY=
# 向量模型 API 根地址。
EMBEDDING_BASE_URL=https://api.openai.com/v1
# 向量维度；当前数据库固定为 1536，不能直接修改。
EMBEDDING_DIMENSION=1536

# 联网搜索 Provider：disabled 或 serper。
WEB_SEARCH_PROVIDER=disabled
# Serper API Key；不启用联网搜索时留空。
WEB_SEARCH_API_KEY=
# Serper API 根地址。
WEB_SEARCH_BASE_URL=https://google.serper.dev

# 单个 API Key 每分钟最多请求次数。
RATE_LIMIT_PER_MINUTE=60
# 对话模型调用超时时间，单位为秒。
ANSWER_TIMEOUT_SECONDS=15
# 单次回答最多使用的证据条数。
MAX_EVIDENCE=8
# 请求正文保留天数；0 表示不保留敏感请求正文。
REQUEST_BODY_RETENTION_DAYS=0

# 远程网页或 API 单次连接超时时间，单位为秒。
REMOTE_FETCH_TIMEOUT_SECONDS=20
# 远程内容最大字节数；20971520 等于 20 MB。
REMOTE_FETCH_MAX_BYTES=20971520
# 远程请求最多允许的安全重定向次数。
REMOTE_FETCH_MAX_REDIRECTS=5
# 网络超时、429 或 5xx 时的自动重试次数。
REMOTE_FETCH_RETRIES=2
# 抓取公开网页时发送的 User-Agent。
REMOTE_FETCH_USER_AGENT=AIKnowledgeBot/2.1 (+public-knowledge-ingestion)
