# =============================================================================
# 智能知识中台 - 部署级环境变量
# 供 docker-compose.prod.yml 使用，定义基础设施（数据库/缓存）的连接参数
#
# 使用方式：
#   1. 复制本文件为 docker/.env：cp docker/.env.example docker/.env
#   2. 填入真实值（生产环境务必使用强密码）
#   3. docker compose -f docker-compose.prod.yml up -d 自动读取
#
# ⚠️ 重要：本文件中的变量需与 backend/.env 中的 DATABASE_URL 保持一致
#   - POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 必须与 DATABASE_URL 中的凭据一致
#   - REDIS_PASSWORD（若设置）必须与 REDIS_URL / CELERY_BROKER_URL 中的密码一致
#   - docker-compose.prod.yml 已在 environment 字段中自动拼接这些变量，
#     无需在 backend/.env 中重复配置容器内的连接地址（compose 会覆盖）
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL 数据库配置
# -----------------------------------------------------------------------------

# 数据库用户名
# 生产环境建议非默认用户名，如 aiknowledge_prod
POSTGRES_USER=aiknowledge

# 数据库密码
# ⚠️ 生产环境务必使用强密码（至少 16 位，含大小写字母+数字+特殊字符）
# 此密码会同时用于 backend/.env 中 DATABASE_URL 的拼接
POSTGRES_PASSWORD=sss980318..

# 数据库名
POSTGRES_DB=knowledge_hub

# -----------------------------------------------------------------------------
# Redis 缓存配置
# -----------------------------------------------------------------------------

# Redis 密码（可选，留空表示无密码）
# ⚠️ 生产环境强烈建议设置密码，防止 Redis 未授权访问
# 设置后，docker-compose.prod.yml 会自动将密码注入到 redis-server 启动命令与
# backend 的 REDIS_URL / CELERY_BROKER_URL / CELERY_RESULT_BACKEND 中
REDIS_PASSWORD=
